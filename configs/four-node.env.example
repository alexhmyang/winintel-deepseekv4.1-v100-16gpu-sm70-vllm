# Author: 数萌AI服务器 (winintel)
# Planned 4 x 4 layout. Set actual network values separately on every node.
WININTEL_REFERENCE_ENV=/opt/winintel-deepseek/.venv
WININTEL_MODEL=/models/DeepSeek-V4.1-Flash
CUDA_HOME=/usr/local/cuda-12.8
WININTEL_NNODES=4
WININTEL_GPUS=4
WININTEL_MASTER=REPLACE_WITH_MASTER_ADDRESS
WININTEL_MASTER_PORT=29561
WININTEL_IB_HCA=REPLACE_WITH_ACTIVE_HCA_AND_PORT
WININTEL_SOCKET_IFACE=REPLACE_WITH_BOOTSTRAP_INTERFACE
WININTEL_NATIVE_SM70=1
WININTEL_FP8_CACHE_MIB=256
WININTEL_FP8_GRAPH=1
WININTEL_EXPERT_SHARED_QUANT=1
WININTEL_EXPERT_SHARED_DECODE=1
WININTEL_COMPACT_GREEDY=1
WININTEL_FP4_PREFILL_ROWS=0
OMP_NUM_THREADS=2
MAX_JOBS=2
